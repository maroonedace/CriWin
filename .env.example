# Discord Token pulled from the Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=insert-discord-token

# Environment (development or production)
ENVIRONMENT=production

# Development Guild ID (only required for development environment)
DEV_GUILD_ID=insert-dev-guild-id

# Largest post the bot will download, in MB. This is the bot's own cap and
# is independent of Discord's per-guild attachment limit.
MAX_POST_MB=50

# Directory holding one Netscape-format cookie file per platform, named
# <platform>.txt.
COOKIE_DIR=/mnt/criwin/cookies
