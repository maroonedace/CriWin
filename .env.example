# Criwin environment configuration
# Copy this file to `.env` and fill in the values. Do NOT commit `.env`.

# --- Discord ---
# Bot token from the Discord Developer Portal.
DISCORD_TOKEN=your-discord-bot-token
# The guild (server) ID the bot operates in.
GUILD_ID=000000000000000000

# --- Logging ---
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# --- PostgreSQL (soundboard metadata) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=discord_bot
POSTGRES_USER=discord_bot
POSTGRES_PASSWORD=your-postgres-password

# --- MinIO / S3 (soundboard audio storage) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=soundboard
MINIO_USE_SSL=false

# --- Media downloads ---
# Directory where downloaded media is written before being sent to Discord.
DOWNLOAD_DIR=/criwin/downloads
