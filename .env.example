# Criwin environment configuration
# Copy this file to `.env` and fill in the values. Do NOT commit `.env`.

# --- Discord ---
# Bot token from the Discord Developer Portal.
DISCORD_TOKEN=your-discord-bot-token
# The guild (server) ID the bot operates in.
GUILD_ID=000000000000000000

# --- Logging ---
# One of DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=criwin
DB_USER=criwin
DB_PASSWORD=your-db-password

# --- Storage (S3) ---
STORAGE_REGION=your-region
STORAGE_ACCESS_KEY=your-minio-access-key
STORAGE_SECRET_KEY=your-minio-secret-key
STORAGE_ENDPOINT=storage:9000
STORAGE_BUCKET_NAME=soundboard
STORAGE_SECURE=false

# --- Media downloads ---
# Directory where downloaded media is written before being sent to Discord.
DOWNLOAD_DIR=/criwin/downloads
# Directory holding the yt-dlp / gallery-dl cookie files.
COOKIE_DIR=/criwin/cookies

# --- Admin web panel ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_PUBLISH_HOST=127.0.0.1
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8080
